{
  "name": "signet",
  "version": "1.0.0",
  "private": true,
  "description": "Signet, a trust critical e signing platform that produces sealed, tamper evident documents with a full audit certificate.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
