# Generate a private local environment (including strong secrets) with: npm run keys
# Do not commit .env.local or put production secrets in this file.
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Signet

# Local MongoDB. Start MongoDB before using database-backed features.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=signet

# `npm run keys` creates fresh local values for these settings.
APP_SECRET=generate-with-npm-run-keys
STORAGE_ENCRYPTION_KEY=generate-with-npm-run-keys
SEAL_PRIVATE_KEY=generate-with-npm-run-keys
SEAL_PUBLIC_KEY=generate-with-npm-run-keys
CRON_SECRET=generate-with-npm-run-keys

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
EMAIL_DRIVER=console
EMAIL_FROM=Signet <no-reply@localhost>
MAX_UPLOAD_BYTES=26214400
SIGNING_SESSION_MINUTES=45
OWNER_SESSION_DAYS=7
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# For S3-compatible storage, set STORAGE_DRIVER=s3 and configure:
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# For SMTP email, set EMAIL_DRIVER=smtp and configure:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# EMAIL_REPLY_TO=

# For Resend email, set EMAIL_DRIVER=resend and configure:
# RESEND_API_KEY=
